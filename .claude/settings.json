{
  "extraKnownMarketplaces": {
    "agent-process-marketplace": {
      "source": {
        "source": "github",
        "repo": "ekolvah/agent-process-distribution"
      }
    }
  },
  "env": {
    "OTEL_RESOURCE_ATTRIBUTES": "vcs.repository.name=ekolvah/agent-process-distribution,vcs.repository.url.full=https://github.com/ekolvah/agent-process-distribution"
  },
  "permissions": {
    "deny": [
      "Bash(sleep:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/skills/agent-process/templates/skill_check.py\" https://github.com/ekolvah/agent-process-distribution/blob/main/skills/agent-process/SKILL.md#install"
          }
        ]
      }
    ]
  }
}
