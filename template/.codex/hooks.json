{
  "description": "Repository safeguards and immediate edit feedback for Codex.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python .agent-process/scripts/codex_hooks.py pre-tool",
            "timeout": 30,
            "statusMessage": "Checking repository command policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python .agent-process/scripts/codex_hooks.py on-edit",
            "timeout": 30,
            "statusMessage": "Checking edited files"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && python .agent-process/scripts/codex_hooks.py stop",
            "timeout": 10,
            "statusMessage": "Checking delivery turn-boundary gate"
          }
        ]
      }
    ]
  }
}
