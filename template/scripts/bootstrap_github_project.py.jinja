#!/usr/bin/env python3
"""Configure this repository's Project and required branch protection.

The Copier answer selected ``{{ github_project_mode }}``. Reusing a Project is
read-only until all required fields have been verified. Creating a Project is
an external write and therefore requires ``--confirm-create``.
"""

from __future__ import annotations

import argparse
import importlib
import json
import subprocess
import sys
from pathlib import Path
from typing import Any

MODE = "{{ github_project_mode }}"
OWNER = "{{ github_project_owner }}"
EXISTING_NUMBER = "{{ existing_github_project_number | default('', true) }}"
PROJECT_TITLE = "{{ github_project_title | default('', true) }}"
REPOSITORY = "{{ github_repository }}"
SETTINGS_PATH = Path(__file__).with_name("project_settings.py")


def _checked(command: list[str], *, input: str | None = None) -> str:
    completed = subprocess.run(
        command, text=True, input=input, capture_output=True, encoding="utf-8"
    )
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.strip() or f"failed: {' '.join(command)}")
    return completed.stdout


def _run(command: list[str]) -> dict[str, Any]:
    try:
        return json.loads(_checked(command))
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid JSON from {' '.join(command)}") from exc


def _fields(number: str) -> list[dict[str, Any]]:
    data = _run(["gh", "project", "field-list", number, "--owner", OWNER, "--format", "json"])
    fields = data.get("fields")
    if not isinstance(fields, list):
        raise RuntimeError("`gh project field-list` returned no fields list")
    return [field for field in fields if isinstance(field, dict)]


def _field(
    fields: list[dict[str, Any]], names: tuple[str, ...], options: set[str]
) -> dict[str, Any]:
    for field in fields:
        values = field.get("options")
        option_names = {
            str(option.get("name", "")).strip().lower()
            for option in values or []
            if isinstance(option, dict)
        }
        if field.get("name") in names and option_names == options and field.get("id"):
            return field
    raise RuntimeError(f"Project lacks one of {names!r} with options {sorted(options)!r}")


def _option_ids(field: dict[str, Any], expected: dict[str, str]) -> dict[str, str]:
    result = {
        key: str(option["id"])
        for key, label in expected.items()
        for option in field.get("options", [])
        if isinstance(option, dict) and option.get("name") == label and option.get("id")
    }
    if set(result) != set(expected):
        raise RuntimeError(f"field {field.get('name')!r} has incomplete options")
    return result


def _write(number: str, project_id: str, fields: list[dict[str, Any]]) -> None:
    priority = _field(fields, ("Priority",), {"high", "medium", "low"})
    status = _field(fields, ("Agent status", "Status"), {"planned", "in progress"})
    source = "\n".join(
        [
            '"""Generated by bootstrap_github_project.py; do not edit manually."""',
            f"PROJECT_NUMBER = {number!r}",
            f"PROJECT_OWNER = {OWNER!r}",
            f"PROJECT_ID = {project_id!r}",
            f"PRIORITY_FIELD_ID = {str(priority['id'])!r}",
            f"PRIORITY_OPTION_IDS = {_option_ids(priority, {'high': 'High', 'medium': 'Medium', 'low': 'Low'})!r}",
            f"STATUS_FIELD_ID = {str(status['id'])!r}",
            f"STATUS_OPTION_IDS = {_option_ids(status, {'planned': 'Planned', 'in-progress': 'In Progress'})!r}",
            "",
            "def require_configured() -> None:",
            "    return None",
            "",
        ]
    )
    temporary_path = SETTINGS_PATH.with_suffix(".py.tmp")
    temporary_path.write_text(source, encoding="utf-8")
    temporary_path.replace(SETTINGS_PATH)


def _rollback_created_project(number: str, cause: Exception) -> None:
    """Delete a Project made by this invocation, then retain the original cause."""
    try:
        _checked(["gh", "project", "delete", number, "--owner", OWNER])
    except RuntimeError as cleanup_exc:
        raise RuntimeError(
            f"{cause}; Project {number} was created but cleanup failed: {cleanup_exc}. "
            f"Delete it with `gh project delete {number} --owner {OWNER}` before retrying"
        ) from cleanup_exc
    raise RuntimeError(
        f"{cause}; Project {number} was deleted, and no configuration was written"
    ) from cause


def _create() -> tuple[str, str]:
    repository = REPOSITORY
    if not repository:
        current = _run(["gh", "repo", "view", "--json", "nameWithOwner"])
        repository = str(current.get("nameWithOwner", ""))
    if not repository:
        raise RuntimeError("cannot resolve github_repository from the current checkout")
    _checked(["gh", "auth", "status"])
    number = ""
    try:
        created = _run(
            [
                "gh",
                "project",
                "create",
                "--owner",
                OWNER,
                "--title",
                PROJECT_TITLE,
                "--format",
                "json",
            ]
        )
        number, project_id = str(created.get("number", "")), str(created.get("id", ""))
        if not number or not project_id:
            raise RuntimeError("`gh project create` returned no number or id")
        _checked(["gh", "project", "link", number, "--owner", OWNER, "--repo", repository])
        for name, options in (
            ("Priority", "High,Medium,Low"),
            ("Agent status", "Planned,In Progress"),
        ):
            _run(
                [
                    "gh",
                    "project",
                    "field-create",
                    number,
                    "--owner",
                    OWNER,
                    "--name",
                    name,
                    "--data-type",
                    "SINGLE_SELECT",
                    "--single-select-options",
                    options,
                    "--format",
                    "json",
                ]
            )
        return number, project_id
    except RuntimeError as exc:
        if not number:
            raise
        _rollback_created_project(number, exc)


def _repository() -> str:
    if REPOSITORY:
        return REPOSITORY
    current = _run(["gh", "repo", "view", "--json", "nameWithOwner"])
    repository = str(current.get("nameWithOwner", ""))
    if not repository:
        raise RuntimeError("cannot resolve github_repository from the current checkout")
    return repository


def _configure_branch_protection() -> None:
    """Apply only the process-owned required contexts to the default branch.

    A pre-existing protection rule may contain review, push, or deletion policy
    owned by the repository. Updating its status-check subresource preserves
    those details while ensuring that the branch requires pull requests; a
    previously unprotected branch receives the complete safe baseline.
    """
    from scripts.check_branch_protection import REQUIRED_CONTEXTS

    repository = _repository()
    viewed = _run(["gh", "repo", "view", repository, "--json", "defaultBranchRef"])
    ref = viewed.get("defaultBranchRef")
    branch = ref.get("name") if isinstance(ref, dict) else None
    if not isinstance(branch, str) or not branch:
        raise RuntimeError("`gh repo view` returned no default branch")
    endpoint = f"repos/{repository}/branches/{branch}/protection"
    contexts = list(REQUIRED_CONTEXTS)
    try:
        protection = json.loads(_checked(["gh", "api", endpoint]))
        if not isinstance(protection, dict):
            raise RuntimeError("branch protection response is not an object")
    except json.JSONDecodeError as exc:
        raise RuntimeError("branch protection response is invalid JSON") from exc
    except RuntimeError as exc:
        if "HTTP 404" not in str(exc):
            raise
        payload = {
            "required_status_checks": {"strict": True, "contexts": contexts},
            "enforce_admins": True,
            "required_pull_request_reviews": {"required_approving_review_count": 0},
            "restrictions": None,
            "required_linear_history": False,
            "allow_force_pushes": False,
            "allow_deletions": False,
            "block_creations": False,
            "required_conversation_resolution": False,
            "lock_branch": False,
            "allow_fork_syncing": False,
        }
        _checked(
            ["gh", "api", "--method", "PUT", endpoint, "--input", "-"],
            input=json.dumps(payload),
        )
        return
    _checked(
        ["gh", "api", "--method", "PATCH", f"{endpoint}/required_status_checks", "--input", "-"],
        input=json.dumps({"strict": True, "contexts": contexts}),
    )
    _checked(["gh", "api", "--method", "POST", f"{endpoint}/enforce_admins"])
    if protection.get("required_pull_request_reviews") is None:
        _checked(
            [
                "gh",
                "api",
                "--method",
                "PATCH",
                f"{endpoint}/required_pull_request_reviews",
                "--input",
                "-",
            ],
            input=json.dumps({"required_approving_review_count": 0}),
        )


def _already_configured() -> bool:
    try:
        import project_settings

        project_settings = importlib.reload(project_settings)
        project_settings.require_configured()
    except (ImportError, RuntimeError):
        return False
    return True


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--confirm-create",
        action="store_true",
        help="allow Project creation in create mode",
    )
    ns = parser.parse_args(argv)
    try:
        already_configured = _already_configured()
        if already_configured:
            _configure_branch_protection()
            print(
                "ok: GitHub Project bootstrap is already configured; branch protection is current"
            )
            return
        if MODE == "create":
            if not ns.confirm_create:
                parser.error("create mode needs --confirm-create")
            number, project_id = _create()
            try:
                _configure_branch_protection()
                _write(number, project_id, _fields(number))
            except (OSError, RuntimeError) as exc:
                _rollback_created_project(number, exc)
        else:
            if not EXISTING_NUMBER:
                raise RuntimeError("existing mode needs existing_github_project_number")
            viewed = _run(
                [
                    "gh",
                    "project",
                    "view",
                    EXISTING_NUMBER,
                    "--owner",
                    OWNER,
                    "--format",
                    "json",
                ]
            )
            number, project_id = EXISTING_NUMBER, str(viewed.get("id", ""))
            if not project_id:
                raise RuntimeError("`gh project view` returned no id")
            _configure_branch_protection()
            _write(number, project_id, _fields(number))
    except (OSError, RuntimeError) as exc:
        print(
            "error: GitHub Project bootstrap did not activate the agent process: "
            f"{exc}. Fix the problem and rerun this command; "
            f"{SETTINGS_PATH} is unchanged.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"ok: GitHub Project {number} is configured; commit {SETTINGS_PATH}")


if __name__ == "__main__":
    main()
