#!/usr/bin/env python3
"""Configure this repository's required GitHub Project.

The Copier answer selected ``{{ github_project_mode }}``. Reusing a Project is
read-only until all required fields have been verified. Creating a Project is
an external write and therefore requires ``--confirm-create``. Appending the
process-owned ``Planned`` option to an activated Project requires a separate
``--confirm-status-setup`` confirmation.
"""

from __future__ import annotations

import argparse
import importlib
import json
import subprocess
import sys
from pathlib import Path
from typing import Any

MODE = "{{ github_project_mode }}"
OWNER = "{{ github_project_owner }}"
EXISTING_NUMBER = "{{ existing_github_project_number | default('', true) }}"
PROJECT_TITLE = "{{ github_project_title | default('', true) }}"
REPOSITORY = "{{ github_repository }}"
SETTINGS_PATH = Path(__file__).with_name("project_settings.py")


def _checked(command: list[str]) -> str:
    completed = subprocess.run(command, text=True, capture_output=True, encoding="utf-8")
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.strip() or f"failed: {' '.join(command)}")
    return completed.stdout


def _run(command: list[str]) -> dict[str, Any]:
    try:
        return json.loads(_checked(command))
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"invalid JSON from {' '.join(command)}") from exc


def _fields(number: str, owner: str = OWNER) -> list[dict[str, Any]]:
    data = _run(["gh", "project", "field-list", number, "--owner", owner, "--format", "json"])
    fields = data.get("fields")
    if not isinstance(fields, list):
        raise RuntimeError("`gh project field-list` returned no fields list")
    return [field for field in fields if isinstance(field, dict)]


def _field(
    fields: list[dict[str, Any]], names: tuple[str, ...], options: set[str], *, subset: bool = False
) -> dict[str, Any]:
    for field in fields:
        values = field.get("options")
        option_names = {
            str(option.get("name", "")).strip().casefold()
            for option in values or []
            if isinstance(option, dict)
        }
        matches = options <= option_names if subset else option_names == options
        if field.get("name") in names and matches and field.get("id"):
            return field
    raise RuntimeError(f"Project lacks one of {names!r} with options {sorted(options)!r}")


def _option_ids(field: dict[str, Any], expected: dict[str, str]) -> dict[str, str]:
    available = {
        str(option.get("name", "")).strip().casefold(): str(option["id"])
        for option in field.get("options", [])
        if isinstance(option, dict) and option.get("id")
    }
    result = {
        key: available[label.casefold()]
        for key, label in expected.items()
        if label.casefold() in available
    }
    if set(result) != set(expected):
        raise RuntimeError(f"field {field.get('name')!r} has incomplete options")
    return result


def _write(number: str, project_id: str, fields: list[dict[str, Any]], owner: str) -> None:
    priority = _field(fields, ("Priority",), {"high", "medium", "low"})
    status = _field(fields, ("Status",), {"planned", "in progress"}, subset=True)
    source = "\n".join(
        [
            '"""Generated by bootstrap_github_project.py; do not edit manually."""',
            "",
            f"PROJECT_NUMBER = {json.dumps(number)}",
            f"PROJECT_OWNER = {json.dumps(owner)}",
            f"PROJECT_ID = {json.dumps(project_id)}",
            f"PRIORITY_FIELD_ID = {json.dumps(str(priority['id']))}",
            f"PRIORITY_OPTION_IDS = {json.dumps(_option_ids(priority, {'high': 'High', 'medium': 'Medium', 'low': 'Low'}))}",
            f"STATUS_FIELD_ID = {json.dumps(str(status['id']))}",
            f"STATUS_OPTION_IDS = {json.dumps(_option_ids(status, {'planned': 'Planned', 'in-progress': 'In Progress'}))}",
            "",
            "",
            "def require_configured() -> None:",
            '    """Fail before any ``gh project`` operation when bootstrap has not run."""',
            "    required = (",
            "        PROJECT_NUMBER,",
            "        PROJECT_OWNER,",
            "        PROJECT_ID,",
            "        PRIORITY_FIELD_ID,",
            "        STATUS_FIELD_ID,",
            "    )",
            "    if (",
            "        not all(required)",
            '        or set(PRIORITY_OPTION_IDS) != {"high", "medium", "low"}',
            '        or set(STATUS_OPTION_IDS) != {"planned", "in-progress"}',
            "    ):",
            "        raise RuntimeError(",
            '            "Agent process is installed but inactive: GitHub Project bootstrap is incomplete; run "',
            '            "`python .agent-process/scripts/bootstrap_github_project.py` first"',
            "        )",
            "",
        ]
    )
    temporary_path = SETTINGS_PATH.with_suffix(".py.tmp")
    temporary_path.write_text(source, encoding="utf-8")
    temporary_path.replace(SETTINGS_PATH)


def _rollback_created_project(number: str, cause: Exception) -> None:
    """Delete a Project made by this invocation, then retain the original cause."""
    try:
        _checked(["gh", "project", "delete", number, "--owner", OWNER])
    except RuntimeError as cleanup_exc:
        raise RuntimeError(
            f"{cause}; Project {number} was created but cleanup failed: {cleanup_exc}. "
            f"Delete it with `gh project delete {number} --owner {OWNER}` before retrying"
        ) from cleanup_exc
    raise RuntimeError(
        f"{cause}; Project {number} was deleted, and no configuration was written"
    ) from cause


def _graphql(query: str, variables: dict[str, Any]) -> dict[str, Any]:
    """Run the one ProjectV2 API boundary with JSON variables."""
    completed = subprocess.run(
        ["gh", "api", "graphql", "--input", "-"],
        input=json.dumps({"query": query, "variables": variables}),
        text=True,
        capture_output=True,
        encoding="utf-8",
    )
    if completed.stdout is None or completed.stderr is None:
        raise RuntimeError("gh api graphql output capture failed")
    if completed.returncode != 0:
        raise RuntimeError(completed.stderr.strip() or "gh api graphql failed")
    try:
        payload = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError("gh api graphql returned invalid JSON") from exc
    if not isinstance(payload, dict) or payload.get("errors"):
        raise RuntimeError(f"gh api graphql returned errors: {payload.get('errors')!r}")
    return payload


def _ensure_builtin_planned(project_id: str) -> None:
    """Append Planned while retaining every existing Status option identity."""
    query = """query($project: ID!) { node(id: $project) { ... on ProjectV2 { fields(first: 100) { nodes { ... on ProjectV2SingleSelectField { id name options { id name color description } } } } } } }"""
    payload = _graphql(query, {"project": project_id})
    node = payload.get("data", {}).get("node", {})
    nodes = node.get("fields", {}).get("nodes", []) if isinstance(node, dict) else []
    status = next(
        (field for field in nodes if isinstance(field, dict) and field.get("name") == "Status"),
        None,
    )
    if not isinstance(status, dict) or not status.get("id"):
        raise RuntimeError("Project lacks built-in Status field")
    options = status.get("options")
    if not isinstance(options, list):
        raise RuntimeError("built-in Status has no readable options")
    preserved = []
    names: set[str] = set()
    for option in options:
        if not isinstance(option, dict) or not all(
            key in option for key in ("id", "name", "color", "description")
        ):
            raise RuntimeError("built-in Status option is incomplete; refusing replacement")
        preserved.append(
            {
                "id": option["id"],
                "name": option["name"],
                "color": option["color"],
                "description": option["description"],
            }
        )
        names.add(str(option["name"]).casefold())
    if "in progress" not in names:
        raise RuntimeError("built-in Status lacks required In Progress option")
    if "planned" in names:
        return
    preserved.append({"name": "Planned", "color": "BLUE", "description": ""})
    mutation = """mutation($field: ID!, $options: [ProjectV2SingleSelectFieldOptionInput!]!) { updateProjectV2Field(input: {fieldId: $field, singleSelectOptions: $options}) { projectV2Field { ... on ProjectV2SingleSelectField { id } } } }"""
    _graphql(mutation, {"field": str(status["id"]), "options": preserved})


def _create() -> tuple[str, str, str]:
    repository = REPOSITORY
    if not repository:
        current = _run(["gh", "repo", "view", "--json", "nameWithOwner"])
        repository = str(current.get("nameWithOwner", ""))
    if not repository:
        raise RuntimeError("cannot resolve github_repository from the current checkout")
    _checked(["gh", "auth", "status"])
    link_owner = OWNER
    if OWNER == "@me":
        viewer = _run(["gh", "api", "user"])
        link_owner = str(viewer.get("login", "")).strip()
        if not link_owner:
            raise RuntimeError("cannot resolve the authenticated login for `gh project link`")
    number = ""
    try:
        created = _run(
            [
                "gh",
                "project",
                "create",
                "--owner",
                OWNER,
                "--title",
                PROJECT_TITLE,
                "--format",
                "json",
            ]
        )
        number, project_id = str(created.get("number", "")), str(created.get("id", ""))
        if not number or not project_id:
            raise RuntimeError("`gh project create` returned no number or id")
        _checked(["gh", "project", "link", number, "--owner", link_owner, "--repo", repository])
        for name, options in (("Priority", "High,Medium,Low"),):
            _run(
                [
                    "gh",
                    "project",
                    "field-create",
                    number,
                    "--owner",
                    OWNER,
                    "--name",
                    name,
                    "--data-type",
                    "SINGLE_SELECT",
                    "--single-select-options",
                    options,
                    "--format",
                    "json",
                ]
            )
        _ensure_builtin_planned(project_id)
        return number, project_id, link_owner
    except RuntimeError as exc:
        if not number:
            raise
        _rollback_created_project(number, exc)


def _configured_project() -> tuple[str, str, str] | None:
    try:
        import project_settings

        project_settings = importlib.reload(project_settings)
        project_settings.require_configured()
    except (ImportError, RuntimeError):
        return None
    number = str(project_settings.PROJECT_NUMBER)
    project_id = str(project_settings.PROJECT_ID)
    owner = str(project_settings.PROJECT_OWNER)
    if owner == "@me":
        query = """query($project: ID!) { node(id: $project) { __typename ... on ProjectV2 { id number owner { __typename ... on User { login } ... on Organization { login } } } } }"""
        payload = _graphql(query, {"project": project_id})
        node = payload.get("data", {}).get("node", {})
        if (
            not isinstance(node, dict)
            or node.get("__typename") != "ProjectV2"
            or str(node.get("id", "")) != project_id
        ):
            raise RuntimeError("configured PROJECT_ID does not identify a readable Project")
        remote_number = str(node.get("number", ""))
        if remote_number != number:
            raise RuntimeError(
                f"configured PROJECT_ID belongs to Project number {remote_number}, "
                f"not configured number {number}"
            )
        project_owner = node.get("owner")
        if not isinstance(project_owner, dict) or project_owner.get("__typename") not in {
            "User",
            "Organization",
        }:
            raise RuntimeError("configured Project has no supported owner")
        owner = str(project_owner.get("login", "")).strip()
        if not owner:
            raise RuntimeError("cannot resolve the configured Project owner")
    return number, project_id, owner


def _already_configured() -> bool:
    return _configured_project() is not None


def _status_setup_target() -> tuple[str, str, str]:
    configured = _configured_project()
    if configured is not None:
        return configured
    if MODE != "existing" or not EXISTING_NUMBER:
        raise RuntimeError(
            "--confirm-status-setup needs an activated Project or existing_github_project_number"
        )
    viewed = _run(
        [
            "gh",
            "project",
            "view",
            EXISTING_NUMBER,
            "--owner",
            OWNER,
            "--format",
            "json",
        ]
    )
    project_id = str(viewed.get("id", ""))
    if not project_id:
        raise RuntimeError("`gh project view` returned no id")
    return EXISTING_NUMBER, project_id, OWNER


def main(argv: list[str] | None = None) -> None:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--confirm-create",
        action="store_true",
        help="allow Project creation in create mode",
    )
    parser.add_argument(
        "--confirm-status-setup",
        action="store_true",
        help="allow appending Planned to built-in Status in an activated Project",
    )
    ns = parser.parse_args(argv)
    if ns.confirm_status_setup:
        try:
            number, project_id, owner = _status_setup_target()
            fields = _fields(number, owner)
            _field(fields, ("Priority",), {"high", "medium", "low"})
            _ensure_builtin_planned(project_id)
            _write(number, project_id, _fields(number, owner), owner)
        except (OSError, RuntimeError) as exc:
            print(
                "error: GitHub Project status setup did not update the agent process: "
                f"{exc}. Fix the problem and rerun this command; "
                f"{SETTINGS_PATH} is unchanged.",
                file=sys.stderr,
            )
            sys.exit(1)
        print(f"ok: GitHub Project {number} Status is configured; commit {SETTINGS_PATH}")
        return
    if _already_configured():
        print("ok: GitHub Project bootstrap is already configured")
        return
    try:
        if MODE == "create":
            if not ns.confirm_create:
                parser.error("create mode needs --confirm-create")
            number, project_id, owner = _create()
            try:
                _write(number, project_id, _fields(number, owner), owner)
            except (OSError, RuntimeError) as exc:
                _rollback_created_project(number, exc)
        else:
            if not EXISTING_NUMBER:
                raise RuntimeError("existing mode needs existing_github_project_number")
            viewed = _run(
                [
                    "gh",
                    "project",
                    "view",
                    EXISTING_NUMBER,
                    "--owner",
                    OWNER,
                    "--format",
                    "json",
                ]
            )
            number, project_id = EXISTING_NUMBER, str(viewed.get("id", ""))
            if not project_id:
                raise RuntimeError("`gh project view` returned no id")
            _write(number, project_id, _fields(number, OWNER), OWNER)
    except (OSError, RuntimeError) as exc:
        print(
            "error: GitHub Project bootstrap did not activate the agent process: "
            f"{exc}. Fix the problem and rerun this command; "
            f"{SETTINGS_PATH} is unchanged.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"ok: GitHub Project {number} is configured; commit {SETTINGS_PATH}")


if __name__ == "__main__":
    main()
