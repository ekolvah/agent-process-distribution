{
  "extraKnownMarketplaces": {
    "agent-process-marketplace": {
      "source": {
        "source": "github",
        "repo": "ekolvah/agent-process-distribution",
        "ref": "v${version}"
      }
    }
  },
  "enabledPlugins": {
    "agent-process@agent-process-marketplace": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$$CLAUDE_PROJECT_DIR/.claude/agent-process-check.py\" https://github.com/ekolvah/agent-process-distribution/blob/v${version}/skills/agent-process/SKILL.md#install"
          }
        ]
      }
    ]
  }
}
